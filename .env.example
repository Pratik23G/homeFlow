# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar + Meet (Nick's Google account). See docs/google-setup.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional. Defaults to the account's main calendar.
GOOGLE_CALENDAR_ID=primary

# Email. Sent from Nick's Gmail via the Gmail API when the Google vars above are set (needs the gmail.send scope).
# Optional display name/address override, e.g. "HomeFlow <nick@gmail.com>". Must be Nick's address or a Gmail alias.
GMAIL_FROM=
# Fallback only (if Gmail isn't set up or fails): Resend. EMAIL_FROM must be on a verified domain to reach real clients.
RESEND_API_KEY=
EMAIL_FROM=HomeFlow <onboarding@resend.dev>
# Where Nick's "new booking" notices go, and where client replies go.
NOTIFY_EMAIL=

# Protects /api/cron/reminders. Any long random string; Vercel Cron sends it automatically.
CRON_SECRET=
